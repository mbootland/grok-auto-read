{
  "manifest_version": 3,
  "name": "Grok Auto Read-Aloud",
  "version": "1.15",
  "description": "Auto-plays Grok's Read Aloud on new replies, then optionally opens Dictation so you can reply by voice.",
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Grok Auto Read-Aloud"
  },
  "background": {
    "service_worker": "bg.js"
  }
}
